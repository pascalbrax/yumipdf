<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pdf26</RootNamespace>
    <!-- AssemblyName must not START with a digit: the CsWinRT AOT source generator derives
         internal generated type names from the assembly name and mis-sanitizes a leading
         digit, producing broken codegen (verified while scaffolding this project - the
         original "26PDF" AssemblyName triggered CS0246/CS1729 in WinRTVtable.g.cs).
         "YumiPDF" starts with a letter, so it does not hit that bug. (It was "PDF26" until the app was renamed:
         this is also the name of the exe.) -->
    <AssemblyName>YumiPDF</AssemblyName>
    <Product>YumiPDF</Product>
    <!-- The name Explorer (Details) and Task Manager show; the exe is YumiPDF.exe (AssemblyName, see above). -->
    <AssemblyTitle>YumiPDF</AssemblyTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;arm64</Platforms>

    <!-- Unpackaged (no MSIX) so it can be shipped via a plain MSI/EXE installer. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- The app is launched with a document path/URL as argv[1] (file association, "Apri con", drag&amp;drop, protocol). -->
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK components the app uses, instead of the "Microsoft.WindowsAppSDK" umbrella package: the umbrella also
         pulls in Windows AI, Windows ML (ONNX Runtime, DirectML) and Widgets, which a PDF viewer does not use but which a
         self-contained build would redistribute (hundreds of MB, and one more license to carry for each). WebView2 still arrives
         through WinUI. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine\PdfEngine.csproj" />
    <ProjectReference Include="..\Printing\Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also shipped next to the exe: AppWindow.SetIcon (see Services/WindowIcon) loads it from disk at runtime. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The picture shown in the About dialog; one copy only, in the repository root. -->
    <Content Include="../../about.png" Link="Assets/about.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fonts bundled in PdfEngine are SIL OFL: their license texts travel with the app (also embedded in PdfEngine.dll). -->
    <Content Include="..\PdfEngine\Fonts\LICENSE-*.txt;..\PdfEngine\Fonts\AUTHORS-*.txt" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The AGPL text, the third-party summary and every third-party license text travel with the app too. -->
    <Content Include="../../LICENSE" Link="Licenses/LICENSE-AGPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="Licenses/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third-party-licenses/**/*" Link="Licenses/third-party/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
      dotnet publish (unlike dotnet build) does not copy the XAML compiler's own generated
      output - $(AssemblyName).pri (the resource index) and every page's .xbf (App.xbf at the
      root, one per Views/*.xaml) - into the publish folder, even though they sit right there in
      $(OutDir) by the time Publish runs (Publish depends on Build). A published app silently
      missing them crashes on startup inside Microsoft.UI.Xaml.dll itself (confirmed live:
      0xc000027b, Event Viewer "Application Error" naming Microsoft.UI.Xaml.dll as the faulting
      module) - the XAML runtime has nothing to load its own Window/pages from. Hooking
      ComputeFilesToPublish (the extensibility point dotnet publish itself uses to decide what
      to copy) to add them explicitly is the standard fix for this gap in unpackaged WinUI3/
      Windows App SDK publishing; RecursiveDir on the .xbf glob keeps Views/*.xbf under their own
      subfolder in the publish output, matching where the app actually looks for them.
  -->
  <Target Name="IncludeXamlCompilerOutputInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- Exclude the publish folder itself: it lives under $(OutDir), and from the second publish on the glob would pick up
           the previous run's copies and nest them as publish\publish\... -->
      <_GeneratedXbf Include="$(OutDir)**\*.xbf" Exclude="$(OutDir)publish\**" />
      <_GeneratedPri Include="$(OutDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_GeneratedXbf)">
        <RelativePath>%(_GeneratedXbf.RecursiveDir)%(_GeneratedXbf.Filename)%(_GeneratedXbf.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_GeneratedPri)">
        <RelativePath>%(_GeneratedPri.Filename)%(_GeneratedPri.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
