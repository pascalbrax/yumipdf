<ContentDialog
    x:Class="Pdf26.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Opzioni"
    PrimaryButtonText="Salva"
    CloseButtonText="Annulla"
    DefaultButton="Primary">

    <!--
        The dialog's own available height is capped by the main window's current size, and a
        ContentDialog does not scroll its content by default - on a modest (non-maximized)
        window the ColorPicker alone is tall enough to push later options (the association
        toggle) off the bottom, invisibly clipped, until the window is enlarged. Wrapping in a
        ScrollViewer with a MaxHeight fixes that regardless of window size, and keeps working
        as more options are added later instead of silently clipping them again.
    -->
    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MinWidth="320">

            <StackPanel Spacing="12">
                <TextBlock Text="Colore sfondo area pagina" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ColorPicker x:Name="BackgroundColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Documenti con pagine di dimensioni diverse" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="MixedPagesOptions" SelectedIndex="0">
                    <RadioButton Content="Adatta alla pagina corrente" />
                    <RadioButton Content="Adatta alla larghezza più comune" />
                    <RadioButton Content="Tutte le pagine alla stessa larghezza" />
                </RadioButtons>
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                           Text="Le pagine sono sempre centrate nella finestra. Con la prima scelta &quot;Adatta a larghezza&quot; riempie la finestra con la pagina che stai leggendo; con la seconda con la larghezza che ha la maggior parte delle pagine (le pagine più larghe si scorrono di lato); con la terza ogni pagina viene ridimensionata alla stessa larghezza, quindi una pagina orizzontale appare più piccola delle altre ma non si scorre mai di lato." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Zoom con CTRL + rotellina del mouse" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="WheelZoomOptions" SelectedIndex="0">
                    <RadioButton Content="Rotellina in avanti ingrandisce, indietro riduce" />
                    <RadioButton Content="Rotellina in avanti riduce, indietro ingrandisce" />
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="AssociatePdfToggle" Header="Associa i file .pdf a YumiPDF"
                              OnContent="Attivo" OffContent="Non attivo" />
                <HyperlinkButton Content="Apri le impostazioni predefinite di Windows..." Click="OnOpenDefaultAppsSettingsClicked" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                           Text="Windows richiede una conferma manuale per rendere YumiPDF l'app predefinita per i file PDF; questa opzione lo rende disponibile nell'elenco delle app da scegliere (tasto destro su un PDF &gt; Apri con, oppure dalle impostazioni predefinite)." />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</ContentDialog>
