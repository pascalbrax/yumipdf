<ContentDialog
    x:Class="Pdf26.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Opzioni"
    PrimaryButtonText="Salva"
    CloseButtonText="Annulla"
    DefaultButton="Primary">

    <StackPanel Spacing="20" MinWidth="320">

        <StackPanel Spacing="12">
            <TextBlock Text="Colore sfondo area pagina" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ColorPicker x:Name="BackgroundColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" />
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch x:Name="AssociatePdfToggle" Header="Associa i file .pdf a PDF26"
                          OnContent="Attivo" OffContent="Non attivo" />
            <HyperlinkButton Content="Apri le impostazioni predefinite di Windows..." Click="OnOpenDefaultAppsSettingsClicked" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="Windows richiede una conferma manuale per rendere PDF26 l'app predefinita per i file PDF; questa opzione lo rende disponibile nell'elenco delle app da scegliere (tasto destro su un PDF &gt; Apri con, oppure dalle impostazioni predefinite)." />
        </StackPanel>

    </StackPanel>

</ContentDialog>
