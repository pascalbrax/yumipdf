<Window
    x:Class="Pdf26.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pdf26.ViewModels"
    xmlns:local="using:Pdf26.Views"
    mc:Ignorable="d">

    <!-- The root grid carries the window-wide shortcuts (Esc, Ctrl+Z, Ctrl+Y). KeyboardAcceleratorPlacementMode="Hidden": WinUI would otherwise show
         a small "Esc" tooltip for them wherever the mouse rests over the window - the whole grid is hover-able. A shortcut on a button keeps its tip. -->
    <Grid RowDefinitions="Auto,*,Auto" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <!-- Esc ends a placement tool, or else clears the selected annotation - and does nothing (not even "handled") otherwise. -->
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <!--
                Undo / redo shortcuts live here, not on the toolbar buttons: those are only shown while the Strumenti panel is
                open, and the accelerator of a collapsed button does not fire. A text box that has focus still keeps Ctrl+Z for itself.
            -->
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoInvoked" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoInvoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="OnRedoInvoked" />
        </Grid.KeyboardAccelerators>

        <CommandBar x:Name="MainCommandBar" Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="Apri..." Click="OnOpenClicked" />
            <!-- Recent documents: a sidebar panel (like Miniature, Indice, Strumenti, Compila modulo and Cerca, it excludes the others). -->
            <AppBarToggleButton Icon="Clock" Label="Recenti" IsChecked="{x:Bind ViewModel.IsRecentPanelOpen, Mode=TwoWay}" />
            <AppBarButton x:Name="PrintButton" Icon="Print" Label="Stampa..." Click="OnPrintClicked" />
            <AppBarSeparator />
            <AppBarButton Icon="Back" Label="Precedente" Command="{x:Bind ViewModel.PreviousPageCommand}" />
            <AppBarButton Icon="Forward" Label="Successiva" Command="{x:Bind ViewModel.NextPageCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="ZoomOut" Label="Riduci" Command="{x:Bind ViewModel.ZoomOutCommand}" />
            <AppBarElementContainer VerticalContentAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ZoomPercentText, Mode=OneWay}" MinWidth="48" TextAlignment="Center" />
            </AppBarElementContainer>
            <AppBarButton Icon="ZoomIn" Label="Ingrandisci" Command="{x:Bind ViewModel.ZoomInCommand}" />
            <AppBarButton Label="Adatta a larghezza" Click="OnFitWidthClicked" />
            <AppBarButton Label="Adatta a pagina" Click="OnFitPageClicked" />
            <AppBarSeparator />
            <AppBarToggleButton Icon="Pictures" Label="Miniature" IsChecked="{x:Bind ViewModel.IsThumbnailPanelOpen, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.ThumbnailButtonVisibility, Mode=OneWay}" />
            <AppBarToggleButton Icon="List" Label="Indice" IsChecked="{x:Bind ViewModel.IsBookmarkPanelOpen, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.BookmarkButtonVisibility, Mode=OneWay}" />
            <AppBarToggleButton Icon="Edit" Label="Compila modulo" IsChecked="{x:Bind ViewModel.IsFormPanelOpen, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.FormButtonVisibility, Mode=OneWay}" />
            <AppBarSeparator />
            <!--
                "Strumenti" opens the sidebar panel with the notes and stamps to place on the page
                (the tools themselves live there, not on the toolbar). "Salva con nome..." writes
                the document, annotations included, to a new file.
            -->
            <AppBarToggleButton Icon="Highlight" Label="Strumenti" IsChecked="{x:Bind ViewModel.IsToolsPanelOpen, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.DocumentToolsVisibility, Mode=OneWay}" />
            <!-- Undo / redo of the edits made to the document (annotations, text, fields): shown only while the Strumenti panel is open. Ctrl+Z, Ctrl+Y and Ctrl+Shift+Z work from anywhere in the window. -->
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Annulla" Command="{x:Bind ViewModel.UndoCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.UndoToolTip, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsToolsPaneOpen, Mode=OneWay}" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Ripeti" Command="{x:Bind ViewModel.RedoCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.RedoToolTip, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsToolsPaneOpen, Mode=OneWay}" />
            <AppBarButton Icon="Save" Label="Salva con nome..." Click="OnSaveAsClicked"
                          Visibility="{x:Bind ViewModel.DocumentToolsVisibility, Mode=OneWay}" />
            <AppBarSeparator />
            <!-- Ctrl+F works from anywhere in the window - a KeyboardAccelerator bubbles up regardless of which control currently has focus. -->
            <AppBarToggleButton x:Name="SearchToggle" Icon="Find" Label="Cerca" IsChecked="{x:Bind ViewModel.IsSearchOpen, Mode=TwoWay}">
                <AppBarToggleButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" />
                </AppBarToggleButton.KeyboardAccelerators>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="Opzioni..." Click="OnSettingsClicked" />
            <AppBarSeparator />
            <AppBarButton Icon="Help" Label="Informazioni" Click="OnAboutClicked" />
        </CommandBar>

        <!--
            Left sidebar: ospita le miniature (Cover Flow verticale), Cerca e Compila modulo -
            condividono lo stesso pannello e si sovrappongono quando più di uno è attivo insieme
            (MainViewModel.IsLeftPaneOpen/LeftPaneWidth), invece di spartirsi lo spazio su due
            lati o spingersi a vicenda. Si apre su richiesta per uno qualsiasi dei tre; le
            miniature restano comunque disponibili solo per documenti di 3+ pagine già caricati
            (MainViewModel.IsThumbnailPaneOpen).
        -->
        <SplitView Grid.Row="1" x:Name="ThumbnailSplitView" IsPaneOpen="{x:Bind ViewModel.IsLeftPaneOpen, Mode=OneWay}"
                   PanePlacement="Left" DisplayMode="Inline" OpenPaneLength="{x:Bind ViewModel.LeftPaneWidth, Mode=OneWay}">

            <SplitView.Pane>
                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">

                    <local:CoverFlowStrip x:Name="ThumbnailStrip" Visibility="{x:Bind ViewModel.IsThumbnailPaneOpen, Mode=OneWay}" />

                    <!--
                        Indice (bookmarks): occupies the same slot as the thumbnails and never
                        shows together with them (MainViewModel.IsBookmarkPanelOpen/IsThumbnailPanelOpen
                        exclude each other). A click goes to the entry's page; the arrow expands or
                        collapses an entry without navigating. Its top inset follows the Cerca bar
                        (OnSearchBarSizeChanged), so the first entries are not hidden under it.
                    -->
                    <TreeView x:Name="BookmarkTree" ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}"
                              SelectionMode="None" ItemInvoked="OnBookmarkInvoked"
                              Visibility="{x:Bind ViewModel.IsBookmarkPaneOpen, Mode=OneWay}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookmarkNodeViewModel">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid HorizontalAlignment="Stretch" Margin="{x:Bind RowMargin}">
                                        <!-- The entry the page being read belongs to: a soft accent tint with a bar on its left edge. -->
                                        <Border Visibility="{x:Bind IsCurrent, Mode=OneWay}" CornerRadius="4" Margin="-4,-2,0,-2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                                        <Border Visibility="{x:Bind IsCurrent, Mode=OneWay}" Width="3" CornerRadius="2" Margin="-4,2,0,2"
                                                HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{x:Bind Title}" FontSize="{x:Bind TitleFontSize}" FontWeight="{x:Bind TitleFontWeight, Mode=OneWay}"
                                                       Opacity="{x:Bind TitleOpacity}" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Title}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PageText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!--
                        Strumenti: notes and stamps to place on the page. Opaque, like the Compila modulo
                        panel, so whatever is under it (thumbnails) does not show through; its top inset
                        follows the Cerca bar (OnSearchBarSizeChanged), same as the index.
                    -->
                    <ScrollViewer x:Name="ToolsPanel" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind ViewModel.IsToolsPaneOpen, Mode=OneWay}">
                        <ScrollViewer.Resources>
                            <!-- One ready-made text stamp: a button in the stamp's own color. -->
                            <DataTemplate x:Key="StampPresetTemplate" x:DataType="vm:TextStampPreset">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Tag="{x:Bind}" Click="OnStampPresetClicked"
                                        Foreground="{x:Bind TextBrush}" FontWeight="SemiBold" Content="{x:Bind Text}"
                                        ToolTipService.ToolTip="Poi fai clic sulla pagina per inserirlo (Esc per annullare)" />
                            </DataTemplate>
                        </ScrollViewer.Resources>
                        <StackPanel Padding="16,12,16,16" Spacing="20">
                            <TextBlock Text="Strumenti" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Note" FontSize="12" Opacity="0.7" />
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              AutomationProperties.Name="Aggiungi una nota"
                                              IsChecked="{x:Bind ViewModel.IsNoteToolActive, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Poi fai clic sulla pagina per inserirla (Esc per annullare)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Comment" />
                                        <TextBlock Text="Aggiungi una nota" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Timbri" FontSize="12" Opacity="0.7" />
                                <!-- The first stamps are always there; the rest unfold with "Mostra altri timbri" (remembered between sessions). -->
                                <ItemsControl ItemsSource="{x:Bind vm:MainViewModel.BasicTextStampPresets}" IsTabStop="False"
                                              ItemTemplate="{StaticResource StampPresetTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{x:Bind vm:MainViewModel.MoreTextStampPresets}" IsTabStop="False"
                                              ItemTemplate="{StaticResource StampPresetTemplate}"
                                              Visibility="{x:Bind ViewModel.AreMoreStampsExpanded, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMoreStampsClicked" AutomationProperties.Name="Mostra altri timbri">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind ViewModel.MoreStampsToggleGlyph, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.MoreStampsToggleText, Mode=OneWay}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <CheckBox Content="Aggiungi la data" IsChecked="{x:Bind ViewModel.AddDateToStamps, Mode=TwoWay}" />
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPickStampImageClicked"
                                        AutomationProperties.Name="Timbro con un'immagine">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Pictures" />
                                        <TextBlock Text="Immagine..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Testo del documento" FontSize="12" Opacity="0.7" />
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              AutomationProperties.Name="Modifica testo"
                                              IsChecked="{x:Bind ViewModel.IsTextEditTool, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Poi fai clic su una riga di testo della pagina (doppio clic per modificarla, Canc per eliminarla)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Edit" />
                                        <TextBlock Text="Modifica testo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                           Text="Seleziona una riga, poi doppio clic (o Invio) per riscriverla, Canc per eliminarla. Ogni riga è a sé: il testo non si riadatta alle righe vicine." />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Campi modulo" FontSize="12" Opacity="0.7" />
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              AutomationProperties.Name="Aggiungi un campo di testo"
                                              IsChecked="{x:Bind ViewModel.IsTextFieldToolActive, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Poi fai clic sulla pagina per inserirlo (Esc per annullare)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Font" />
                                        <TextBlock Text="Campo di testo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              AutomationProperties.Name="Aggiungi una casella di controllo"
                                              IsChecked="{x:Bind ViewModel.IsCheckBoxFieldToolActive, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Poi fai clic sulla pagina per inserirla (Esc per annullare)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Accept" />
                                        <TextBlock Text="Casella di controllo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <CheckBox Content="Aggancia alla griglia" IsChecked="{x:Bind ViewModel.IsSnapToGridEnabled, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Mostra una griglia di punti (uno ogni 10 pt) sulle pagine e aggancia alla griglia campi, note e timbri quando li inserisci, sposti o ridimensioni: più facile allineare più campi uno sotto l'altro" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                           Text="I campi vengono scritti nel file quando lo salvi con &quot;Salva con nome...&quot;: il documento salvato si riapre con i campi già compilabili." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Recenti: the documents opened last, newest first. A click opens one (and closes
                        the panel); the cross removes it from the list; "Svuota elenco" empties it.
                    -->
                    <Grid x:Name="RecentPanel" RowDefinitions="Auto,*,Auto" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                          Visibility="{x:Bind ViewModel.IsRecentPanelOpen, Mode=OneWay}">
                        <TextBlock Text="File recenti" Style="{StaticResource SubtitleTextBlockStyle}" Margin="16,12,16,8" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentEntries}" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="OnRecentEntryClicked">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentFileEntry">
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,6" ToolTipService.ToolTip="{x:Bind Path}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Folder}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Tag="{x:Bind}" Click="OnRemoveRecentClicked" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Padding="6"
                                                AutomationProperties.Name="Rimuovi dall'elenco" ToolTipService.ToolTip="Rimuovi dall'elenco">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="Nessun file recente" Opacity="0.6" Margin="16,8"
                                   Visibility="{x:Bind ViewModel.HasNoRecentFiles, Mode=OneWay}" />
                        <Button Grid.Row="2" Content="Svuota elenco" Margin="16" HorizontalAlignment="Stretch" Click="OnClearRecentClicked" />
                    </Grid>

                    <!--
                        Cerca: fascia in alto, sovrapposta alle miniature se entrambe attive -
                        stesso sfondo/bordo che aveva sopra l'area pagine, ma in verticale: qui
                        la barra è molto più stretta di quanto non fosse sopra il documento.
                    -->
                    <Border x:Name="SearchBar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8" Visibility="{x:Bind ViewModel.IsSearchOpen, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="SearchBox" PlaceholderText="Cerca nel testo del documento..."
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnSearchBoxKeyDown" />
                            <TextBlock Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="&#x2039;" MinWidth="32" Command="{x:Bind ViewModel.FindPreviousCommand}" ToolTipService.ToolTip="Risultato precedente" />
                                <Button Content="&#x203A;" MinWidth="32" Command="{x:Bind ViewModel.FindNextCommand}" ToolTipService.ToolTip="Risultato successivo" />
                                <Button Content="&#x2715;" MinWidth="32" Click="OnCloseSearchClicked" ToolTipService.ToolTip="Chiudi la ricerca" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Compila modulo: copre l'intero pannello quando attivo (serve più spazio
                        di quanto lascerebbero le miniature o Cerca sotto) - sovrapposto a
                        entrambi per lo stesso motivo.
                    -->
                    <Grid RowDefinitions="Auto,*,Auto" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                          Visibility="{x:Bind ViewModel.IsFormPanelOpen, Mode=OneWay}">

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,12" Spacing="8">
                            <TextBlock Text="Compila modulo" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <!--
                            One editable control per AcroForm field - see FormFieldEntryViewModel.
                            Only Text and CheckBox/RadioButton fields can actually be written
                            (PdfFormFiller.SetFieldValue/SetChecked); combo/list boxes, buttons and
                            signatures are shown read-only for now (docs/ROADMAP.md M2).
                        -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FormFields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Side gutter: a Margin on the panel itself, so the fields never sit flush against the pane's edges. -->
                                        <StackPanel Orientation="Vertical" Spacing="12" Margin="20,0,20,16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FormFieldEntryViewModel">
                                        <StackPanel Orientation="Vertical" Spacing="4">

                                            <StackPanel Orientation="Vertical" Visibility="{x:Bind TextFieldVisibility}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" Opacity="0.7" />
                                                <TextBox Text="{x:Bind Value, Mode=OneWay}" TextChanged="{x:Bind OnTextChanged}" LostFocus="{x:Bind CommitText}"
                                                         AcceptsReturn="{x:Bind IsMultiline}" TextWrapping="{x:Bind OverlayTextWrapping}" />
                                            </StackPanel>

                                            <CheckBox Visibility="{x:Bind CheckBoxFieldVisibility}" Content="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                      Checked="{x:Bind OnCheckedChanged}" Unchecked="{x:Bind OnCheckedChanged}" />

                                            <!--
                                                A native RadioButton (not CheckBox): it already reads
                                                as "exactly one of these" both visually (a round dot,
                                                not a checkmark in a square) and behaviorally -
                                                GroupName ties every widget sharing this field's PDF
                                                /T name into one WinUI-level exclusive group too,
                                                on top of PdfFormFiller's own radio-group handling.
                                            -->
                                            <RadioButton Visibility="{x:Bind RadioButtonFieldVisibility}" Content="{x:Bind Name}"
                                                         GroupName="{x:Bind Name}"
                                                         IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                         Checked="{x:Bind OnCheckedChanged}" Unchecked="{x:Bind OnCheckedChanged}" />

                                            <StackPanel Orientation="Vertical" Visibility="{x:Bind ComboBoxFieldVisibility}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" Opacity="0.7" />
                                                <ComboBox ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedOptionIndex, Mode=TwoWay}"
                                                          PlaceholderText="(nessuna selezione)" HorizontalAlignment="Stretch" />
                                            </StackPanel>

                                            <StackPanel Orientation="Vertical" Visibility="{x:Bind ListBoxFieldVisibility}">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" Opacity="0.7" />
                                                <ListView ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedOptionIndex, Mode=TwoWay}"
                                                          SelectionMode="Single" MaxHeight="160" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </StackPanel>

                                            <Button Visibility="{x:Bind ButtonFieldVisibility}" Content="{x:Bind Name}"
                                                    Click="{x:Bind OnButtonClicked}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                                            <StackPanel Orientation="Vertical" Visibility="{x:Bind ReadOnlyFieldVisibility}">
                                                <TextBlock FontSize="12" Opacity="0.7">
                                                    <Run Text="{x:Bind Name}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{x:Bind TypeLabel}" />
                                                </TextBlock>
                                                <TextBox Text="{x:Bind Value}" IsEnabled="False" />
                                            </StackPanel>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8" Padding="16">
                            <CheckBox Content="Unisci prima di salvare" IsChecked="{x:Bind ViewModel.FlattenBeforeSave, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                       Text="Unisce i valori compilati al contenuto della pagina: diventano definitivi e non sarà più possibile modificarli in questa sessione. Il file originale non viene mai sovrascritto." />
                            <Button Content="Salva con nome..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnSaveFilledFormClicked" />
                        </StackPanel>

                    </Grid>

                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid RowDefinitions="Auto,*">

                <!--
                    Banners above the pages, stacked when more than one applies; each is closable
                    and only present when it has something to say. Digital signature: what the
                    document's signatures amount to (MainViewModel.ApplySignatureReport). PDF/A:
                    that the document declares itself PDF/A (ApplyPdfAStatus) - informational blue,
                    since a document being PDF/A is neither good nor bad news.
                -->
                <StackPanel Grid.Row="0">
                    <InfoBar IsOpen="{x:Bind ViewModel.IsSignatureBannerOpen, Mode=TwoWay}" IsClosable="True" CornerRadius="0"
                             Severity="{x:Bind ViewModel.SignatureBannerSeverity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.SignatureBannerTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.SignatureBannerMessage, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.IsPdfABannerOpen, Mode=TwoWay}" IsClosable="True" CornerRadius="0"
                             Severity="Informational"
                             Title="{x:Bind ViewModel.PdfABannerTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.PdfABannerMessage, Mode=OneWay}">
                        <InfoBar.Resources>
                            <!--
                                The informational icon defaults to the user's accent color, which for a
                                red accent reads as an error. A fixed blue keeps "informational" looking
                                like information whatever accent Windows is set to.
                            -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#0F6CBD" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#479EF5" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </InfoBar.Resources>
                    </InfoBar>
                </StackPanel>

                <Grid Grid.Row="1">

                <ScrollViewer x:Name="PagesScrollViewer"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ZoomMode="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                              Background="{x:Bind ViewModel.PageAreaBackground, Mode=OneWay}">
                    <!--
                        Every page gets a correctly-sized placeholder up front (ItemsControl over a
                        plain, non-virtualizing StackPanel) so the whole document scrolls
                        continuously and the scrollbar is right immediately; only the pages around
                        the current one (and those on screen) have a bitmap - see MainViewModel.RenderPagesAsync.
                    -->
                    <ItemsControl x:Name="PagesItemsControl" ItemsSource="{x:Bind ViewModel.Pages}">
                        <ItemsControl.Resources>
                            <!--
                                One soft shadow shared by every page (Translation on the page border sets its depth).
                                No explicit receiver: ThemeShadow.Receivers.Add(...) crashes the app at startup (access
                                violation in the WinUI projection), and the shadow renders fine without it.
                            -->
                            <ThemeShadow x:Key="PageShadow" />
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- The 24 px around the pages are a Margin here: the ItemsControl's own Padding was measured to have no effect (pages sat flush against the top-left of the view). -->
                                <StackPanel Orientation="Vertical" Spacing="16" HorizontalAlignment="Left" Margin="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PdfPageViewModel">
                                <!--
                                    One row per page, at least as wide as the window and no wider than the page needs: a narrow page
                                    sits in the middle of the window however wide another page of the document is (the panel is as
                                    wide as the widest row, and a row does not stretch to it).
                                -->
                                <Grid HorizontalAlignment="Left" MinWidth="{x:Bind Owner.PageRowMinWidth, Mode=OneWay}">
                                <Border HorizontalAlignment="Center" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Shadow="{StaticResource PageShadow}" Translation="0,0,16"
                                        Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}">
                                    <Grid>
                                        <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Fill" />

                                        <!-- The dotted alignment grid, only while "Aggancia alla griglia" is on (PdfGridLayer). -->
                                        <local:PdfGridLayer Page="{x:Bind}" IsHitTestVisible="False"
                                                            Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}" />

                                        <!--
                                            Drag-to-select text: a transparent layer, hit-test
                                            visible only while this page has native text
                                            (PdfTextSelectionOverlay/PdfPageViewModel.HasNativeText) -
                                            a scanned page's clicks pass straight through it. Sits
                                            below the field overlays below so a field still gets
                                            its own clicks first.
                                        -->
                                        <local:PdfTextSelectionOverlay Page="{x:Bind}"
                                                                        Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}" />

                                        <!--
                                            In-place field editing directly on the page: one
                                            overlay per editable/checkable field, framed so its
                                            boundary is visible even before the user interacts
                                            with it. Shares FormFieldEntryViewModel (and its
                                            commit methods) with the side panel's list - editing
                                            through either one updates the same object.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind Fields}" IsTabStop="False"
                                                      Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}">
                                            <!--
                                                ItemsControl's default container is a generated
                                                ContentPresenter, so a Canvas ItemsPanel with
                                                Canvas.Left/Top bound on the DataTemplate root
                                                does not position anything (the root is a
                                                grandchild of the Canvas, not its direct child -
                                                confirmed live: every item landed at (0,0)). A
                                                plain Grid panel stacks every item in the same
                                                cell instead, and each item positions itself with
                                                Margin (a normal property x:Bind can set directly
                                                on the template root) plus Left/Top alignment.
                                            -->
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FormFieldEntryViewModel">
                                                    <Grid Margin="{x:Bind OverlayMargin, Mode=OneWay}"
                                                          Width="{x:Bind OverlayWidth, Mode=OneWay}" Height="{x:Bind OverlayHeight, Mode=OneWay}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Visibility="{x:Bind OverlayVisibility, Mode=OneWay}">

                                                        <!--
                                                            MinHeight/MinWidth reset to 0: TextBox's
                                                            default style otherwise enforces its own
                                                            ~32px minimum, taller than most AcroForm
                                                            field rects, which got clipped against the
                                                            bottom edge of this Grid's much smaller
                                                            declared Height.

                                                            Background is fully opaque, not a tint:
                                                            the page bitmap underneath already has
                                                            the committed value baked into it (PDFium's
                                                            FPDF_FFLDraw, so the field still reads
                                                            correctly with the overlay closed) - a
                                                            translucent background let that native
                                                            rendering show through behind this control's
                                                            own text, doubling it up in two different
                                                            fonts/sizes once a field had been edited.
                                                        -->
                                                        <TextBox Visibility="{x:Bind TextFieldVisibility}"
                                                                 Background="White" BorderBrush="#FF2683DB" BorderThickness="1.5"
                                                                 Padding="2,0" MinHeight="0" MinWidth="0" VerticalContentAlignment="{x:Bind OverlayVerticalContentAlignment}"
                                                                 AcceptsReturn="{x:Bind IsMultiline}" TextWrapping="{x:Bind OverlayTextWrapping}"
                                                                 FontSize="{x:Bind OverlayFontSize, Mode=OneWay}"
                                                                 Text="{x:Bind Value, Mode=OneWay}" TextChanged="{x:Bind OnTextChanged}" LostFocus="{x:Bind CommitText}"
                                                                 ToolTipService.ToolTip="{x:Bind Name}" />

                                                        <!--
                                                            CornerRadius switches this same frame
                                                            between a checkbox's square and a radio
                                                            button's circle (OverlayCornerRadius,
                                                            computed alongside the rest of the
                                                            overlay's geometry in UpdateOverlay) -
                                                            a radio group only reads as "exactly
                                                            one of these" when its options actually
                                                            look like radio buttons. The checkmark
                                                            glyph is a checkbox's own "on" mark; the
                                                            filled dot is a radio button's - only
                                                            one of the two is ever visible for a
                                                            given field (CheckedGlyphVisibility/
                                                            CheckedDotVisibility both factor in the
                                                            field's own type, not just IsChecked).
                                                        -->
                                                        <Border Visibility="{x:Bind CheckableFieldVisibility}"
                                                                Background="White" BorderBrush="#FF2683DB" BorderThickness="1.5"
                                                                CornerRadius="{x:Bind OverlayCornerRadius, Mode=OneWay}"
                                                                Tapped="{x:Bind OnOverlayCheckTapped}" ToolTipService.ToolTip="{x:Bind Name}">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE73E;" Foreground="#FF2683DB"
                                                                          FontSize="{x:Bind OverlayFontSize, Mode=OneWay}"
                                                                          Visibility="{x:Bind CheckedGlyphVisibility, Mode=OneWay}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Ellipse Fill="#FF2683DB"
                                                                         Width="{x:Bind OverlayFontSize, Mode=OneWay}" Height="{x:Bind OverlayFontSize, Mode=OneWay}"
                                                                         Visibility="{x:Bind CheckedDotVisibility, Mode=OneWay}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>

                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Notes and stamps on this page: selectable, movable,
                                            resizable, deletable (PdfAnnotationLayer), and the click
                                            target while a placement tool is active. Above the
                                            field overlays so a stamp placed over a field is the
                                            thing a click lands on.
                                        -->
                                        <!--
                                            Lines of text, while "Modifica testo" is on (PdfTextEditLayer). Below the
                                            annotation layer: a note or stamp over a line is what a click lands on.
                                        -->
                                        <local:PdfTextEditLayer Page="{x:Bind}"
                                                                 Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}" />

                                        <local:PdfAnnotationLayer Page="{x:Bind}"
                                                                   Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}" />

                                        <!--
                                            Search-result highlights: purely a screen overlay,
                                            drawn the same way as the field overlays above but
                                            never written into the PDF - see PdfPageViewModel.
                                            Highlights/MainViewModel's "Text search / OCR"
                                            region. Not hit-test visible, so it never steals a
                                            click meant for the page or a field underneath it.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind Highlights}" IsTabStop="False" IsHitTestVisible="False"
                                                      Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PdfSearchHighlightViewModel">
                                                    <Rectangle Margin="{x:Bind Margin}" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Fill="#802683DB" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            The drag-to-select highlight itself - painted the same
                                            way as a search highlight (PdfTextSelectionOverlay
                                            above drives the actual drag/hit-testing), in its own
                                            collection so a selection and a search match never
                                            fight over the same rectangles.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind Selection}" IsTabStop="False" IsHitTestVisible="False"
                                                      Width="{x:Bind PixelWidth, Mode=OneWay}" Height="{x:Bind PixelHeight, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PdfSearchHighlightViewModel">
                                                    <Rectangle Margin="{x:Bind Margin}" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Fill="#4D2683DB" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                    <!-- Handle on the sidebar's edge: opens/closes whichever of thumbnails or index it shows (OnSidebarHandleClicked). -->
                    <Button x:Name="SidebarHandle" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="18" Height="72" Padding="0" CornerRadius="0,6,6,0"
                            Visibility="{x:Bind ViewModel.SidebarHandleVisibility, Mode=OneWay}"
                            Click="OnSidebarHandleClicked"
                            AutomationProperties.Name="Mostra o nascondi miniature o indice"
                            ToolTipService.ToolTip="Miniature / Indice">
                        <FontIcon x:Name="SidebarHandleGlyph" Glyph="&#xE76C;" FontSize="10" />
                    </Button>

                </Grid>
                </Grid>
            </SplitView.Content>

        </SplitView>

        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Padding="12,6" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" VerticalAlignment="Center" />
            <!--
                "PDF/A-2B" (etc.) once the open document's own XMP metadata claims conformance,
                nothing at all for a document that does not - never an independently verified
                result (see PdfEngine.PdfAConformance's remarks). Opacity only, no color coding:
                this is informational, not a warning.
            -->
            <TextBlock Text="{x:Bind ViewModel.PdfAStatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
            <!-- OCR: "OCR in corso: 3/12 pagine" while the background pass runs, "OCR eseguito su 12 pagine" afterwards; empty for a document with its own text. -->
            <TextBlock Text="{x:Bind ViewModel.OcrStatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
            <!-- Page render in the background after a zoom, a scroll or an open: "Rendering di 3 pagine..." (empty when idle). -->
            <TextBlock Text="{x:Bind ViewModel.RenderStatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
            <!-- Digital signatures: shown only for a signed document; the icon's color says how it stands (green intact, amber changed/unverifiable, red invalid). -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SignatureStatusVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          Visibility="{x:Bind ViewModel.IsSignatureIntact, Mode=OneWay}" />
                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Visibility="{x:Bind ViewModel.IsSignatureCaution, Mode=OneWay}" />
                <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          Visibility="{x:Bind ViewModel.IsSignatureAltered, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SignatureStatusText, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
            <ProgressBar Width="160" VerticalAlignment="Center"
                         Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                         IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                         Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.AnnotationHint, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock Text="&#x25CF; Modifiche non salvate" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Memory used by the whole app (working set), refreshed every couple of seconds by MainWindow. -->
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}" Margin="16,0,12,0"
                   VerticalAlignment="Center" Opacity="0.7" />
        </Grid>

    </Grid>
</Window>
