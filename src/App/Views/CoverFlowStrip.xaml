<UserControl
    x:Class="Pdf26.Views.CoverFlowStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True" UseSystemFocusVisuals="True"
    AutomationProperties.Name="Miniature delle pagine">

    <Grid x:Name="Root" RowDefinitions="*,Auto" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

        <!-- Slots are added in code (see the class remarks): a fixed handful, reused for whichever pages are near the center. -->
        <Canvas x:Name="ItemsCanvas" Grid.Row="0" Background="Transparent" SizeChanged="OnCanvasSizeChanged" />

        <!-- Pages dissolve into the background toward both ends of the strip. -->
        <Rectangle Grid.Row="0" Height="72" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.Row="0" Height="72" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <TextBlock x:Name="PageLabel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,14"
                   Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</UserControl>
