<ContentDialog
    x:Class="Pdf26.Views.PasswordPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Documento protetto"
    PrimaryButtonText="Apri"
    CloseButtonText="Annulla"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="300">
        <TextBlock x:Name="MessageText" Text="Questo documento richiede una password." TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordInput" PlaceholderText="Password" />
    </StackPanel>

</ContentDialog>
