<ContentDialog
    x:Class="Pdf26.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Informazioni su YumiPDF"
    CloseButtonText="Chiudi"
    DefaultButton="Close">

    <StackPanel Spacing="16" MinWidth="320" MaxWidth="360">

        <!-- The name and version sit under the picture, centered. -->
        <Image x:Name="AboutImage" Width="170" Height="170" HorizontalAlignment="Center" />
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="YumiPDF" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="(Codename PDF26)" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Opacity="0.7" HorizontalAlignment="Center" />
            <TextBlock x:Name="BuildDateText" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap"
                   Text="Visualizzatore, editor e compilatore di moduli PDF nativo per Windows 10 e 11." />

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="Componenti di terze parti: PDFium (Apache-2.0), CommunityToolkit.Mvvm e librerie .NET (MIT), iText Core (AGPL-3.0), Windows App SDK e Win2D (Microsoft), font Liberation (derivati) e Noto Sans (SIL OFL 1.1)." />

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="Software libero: GNU AGPL v3 o successiva. Sorgenti: github.com/pascalbrax/yumipdf. Testi delle licenze: cartella Licenses." />

        <TextBlock x:Name="CopyrightText" Opacity="0.6" FontSize="12" />

    </StackPanel>

</ContentDialog>
