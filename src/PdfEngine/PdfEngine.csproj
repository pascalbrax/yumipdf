<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PdfEngine</RootNamespace>
    <AssemblyName>PdfEngine</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;arm64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prebuilt PDFium native binaries (Apache-2.0), covers win-x64/win-x86/win-arm64 via runtimes/ folders.
         https://github.com/bblanchon/pdfium-binaries -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="153.0.7999" />
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Open-source fallback fonts (SIL OFL 1.1; see Fonts/LICENSE-*.txt), embedded so the exe stays self-contained.
         Used to rewrite a line of text whose own font lacks a glyph the user typed - see Editing/PdfTextEditing.cs. -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="PdfEngine.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\LICENSE-*.txt;Fonts\AUTHORS-*.txt" LogicalName="PdfEngine.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
