<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PdfEngine</RootNamespace>
    <AssemblyName>PdfEngine</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;arm64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prebuilt PDFium native binaries (Apache-2.0), covers win-x64/win-x86/win-arm64 via runtimes/ folders.
         https://github.com/bblanchon/pdfium-binaries -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="153.0.7999" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEngine.Tests" />
  </ItemGroup>

</Project>
